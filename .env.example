# Medirian Client — the owner's configuration, in one place.
#
# Copy this file to .env (same folder) and fill it in. .env is ignored by git: never commit it.
# Step-by-step guide for every value: docs/OWNER_SETUP.md
#
# Three kinds of values live here and they are kept apart on purpose:
#   1. PUBLIC  — built into the launcher. Anyone who installs Medirian Client can read them (they are
#                ids and addresses, like on any website). Only these exact names are embedded; nothing
#                else from this file ever reaches the app (launcher/src/main/core/config.ts).
#   2. SECRETS — used only while building / signing a release. Never built into anything. For GitHub
#                Actions put them into the repository's Secrets instead (same names).
#   3. SERVER  — read by Medirian Services (backend/) on your server.
#
# Every address must use HTTPS. Plain http:// is accepted only for this computer (localhost /
# 127.0.0.1) while testing; a launcher build refuses other http:// addresses.

# =====================================================================================================
# 1. PUBLIC — built into the launcher (GitHub: Settings → Secrets and variables → Actions → Variables)
# =====================================================================================================

# Azure App Registration → Overview → "Application (client) ID" (a GUID). Enables "Sign in with Microsoft".
MEDIRIAN_MSA_CLIENT_ID=YOUR_AZURE_APPLICATION_CLIENT_ID

# Discord Developer Portal → your application → General Information → "Application ID" (digits only).
MEDIRIAN_DISCORD_APP_ID=YOUR_DISCORD_APPLICATION_ID

# Medirian Services base URL, HTTPS, no trailing slash (accounts, cosmetics, cloud profiles, profile codes).
MEDIRIAN_SERVICES_URL=https://api.your-domain.example

# The stable release channel. With GitHub Releases this is always:
#   https://github.com/<owner>/<repo>/releases/latest/download/release-manifest.json
# (the release workflow fills it in by itself; set it here for local builds)
MEDIRIAN_MANIFEST_URL=https://github.com/YOUR_GITHUB_USER/YOUR_REPO/releases/latest/download/release-manifest.json

# How Modrinth can reach you (e-mail or URL). Sent in the launcher's User-Agent, as Modrinth's API
# terms ask. Modrinth needs no API key for searching and downloading mods.
MEDIRIAN_CONTACT=you@your-domain.example

# =====================================================================================================
# 2. SECRETS — release signing (GitHub: Settings → Secrets and variables → Actions → Secrets;
#    the AZURE_SIGNING_* names are not secret and go to Variables)
# =====================================================================================================

# Windows code signing — ONE of the two ways (docs/OWNER_SETUP.md, "Code signing"):
#
# a) An Authenticode certificate file: the .pfx as base64 (or a path / https URL to it) + its password.
#    electron-builder uses WIN_CSC_* for Windows. (Certificates issued since June 2023 keep their key on
#    a hardware token or in a cloud HSM and cannot be exported to a .pfx — then use b) or your
#    certificate vendor's cloud signing.)
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
#
# b) Azure Artifact Signing: Microsoft keeps the key; the release workflow signs through it.
#    Artifact Signing account → Overview → "Account URI" (e.g. https://weu.codesigning.azure.net/)
AZURE_SIGNING_ENDPOINT=
#    the Artifact Signing account name, the certificate profile name and the subject name (CN) it signs as
AZURE_SIGNING_ACCOUNT=
AZURE_SIGNING_PROFILE=
AZURE_SIGNING_PUBLISHER=
#    an Entra ID app registration (service principal) with the "Artifact Signing Certificate Profile
#    Signer" role on the profile: Directory (tenant) ID, Application (client) ID and a client secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GitHub Variables for releases signed outside GitHub Actions (a certificate on a hardware token, see
# docs/OWNER_SETUP.md "Code signing", variant C) or for test releases:
#   MEDIRIAN_ALLOW_UNSIGNED=1  build the Windows installer unsigned in CI (never publish it as it is)
#   MEDIRIAN_RELEASE_DRAFT=1   create the GitHub release as a draft, to replace files before publishing
MEDIRIAN_ALLOW_UNSIGNED=
MEDIRIAN_RELEASE_DRAFT=

# macOS signing and notarization (only if you publish the macOS build): the "Developer ID Application"
# certificate as .p12 (base64 / path) + password, and the Apple ID that notarizes.
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# =====================================================================================================
# 3. SERVER — Medirian Services (backend/). On the server, keep only this section.
# =====================================================================================================

# The domain of MEDIRIAN_SERVICES_URL (without https://). Caddy gets its certificate for it.
MEDIRIAN_SERVICES_DOMAIN=api.your-domain.example
# Let's Encrypt notices about the certificate go here.
MEDIRIAN_SERVICES_ACME_EMAIL=you@your-domain.example
# Only for running the service without Docker (docker-compose sets them itself):
MEDIRIAN_SERVICES_PORT=8080
MEDIRIAN_SERVICES_HOST=127.0.0.1
MEDIRIAN_SERVICES_DATA_DIR=./data
# 1 behind the HTTPS reverse proxy (production): real client addresses, plain HTTP refused, HSTS.
MEDIRIAN_SERVICES_TRUST_PROXY=0

# =====================================================================================================
# Development only — leave empty for releases
# =====================================================================================================

# Another data folder than %APPDATA%\.medirian (launcher and game).
MEDIRIAN_HOME=
# A fake Mojang session server for testing services with offline accounts (backend/dev).
MEDIRIAN_SESSION_SERVER=
